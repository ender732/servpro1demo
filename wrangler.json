{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ender732-restoration-estimator-pro",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.mjs", "**/*.js"]
    }
  ],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  }
}
